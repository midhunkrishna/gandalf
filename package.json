{
  "name": "gandalf",
  "version": "0.0.0",
  "description": "Teaches the code changes behind each commit/ticket — multi-level, scroll-narrated lessons generated by Claude Code.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "gandalf": "./bin/gandalf.ts"
  },
  "scripts": {
    "gandalf": "tsx bin/gandalf.ts",
    "generate": "tsx bin/gandalf.ts generate",
    "serve": "tsx bin/gandalf.ts serve",
    "dev": "vite",
    "build:web": "vite build",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-toggle-group": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@xyflow/react": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^12.1.0",
    "d3-hierarchy": "^3.1.2",
    "d3-sankey": "^0.12.3",
    "d3-shape": "^3.2.0",
    "diff2html": "^3.4.56",
    "elkjs": "^0.9.3",
    "framer-motion": "^11.18.2",
    "hono": "^4.12.27",
    "lenis": "^1.3.25",
    "lucide-react": "^0.451.0",
    "mermaid": "^11.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shiki": "^1.29.2",
    "tailwind-merge": "^2.6.1",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-sankey": "^0.12.5",
    "@types/d3-shape": "^3.1.8",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.2",
    "playwright": "^1.61.1",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.21",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.1.1"
  }
}
